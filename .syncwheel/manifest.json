{
  "authority": {
    "allow": [
      "source_change",
      "runtime_change"
    ],
    "deny": [
      "destructive_rewrite"
    ],
    "mode": "ai-managed"
  },
  "channels": [],
  "coordination": {
    "gc": {
      "backup_keep": 2,
      "backup_retention_days": 30,
      "worktree_grace_days": 7
    },
    "id": "default",
    "mode": "active-active",
    "remote": "origin",
    "state_branch": "syncwheel/state/default"
  },
  "defaults": {
    "base_branch": "main",
    "base_ref": "origin/main",
    "canonical_remote": "origin",
    "integration_membership": "required",
    "publication_remote": "origin"
  },
  "integration": {
    "base": "origin/main",
    "branch": "main-integration",
    "stacks": [
      "stack-target"
    ],
    "strategy": "cherry-pick"
  },
  "landing": {
    "checks": null,
    "mode": "disabled",
    "strategy": "merge"
  },
  "repository_mode": "delivery",
  "stacks": [
    {
      "base": "origin/main",
      "branch": "pr/stack-target",
      "commits": [
        "f9cc3893a81943b757241f9122861e57e63a9d0e",
        "4c94a744d027c323b05e10c3c434189580d31bc3",
        "260faf31dd0e81c93c19555b7dc0fe96c0e45c27"
      ],
      "id": "stack-target",
      "integration_branch": "main-integration",
      "meta": {
        "purpose": "Update a stack delivery target without changing its source projection"
      },
      "publication": {
        "enabled": true
      },
      "state": "published",
      "target_branch": "main",
      "target_remote": "origin"
    }
  ],
  "syncwheel_tracking": "git-tracked",
  "syncwheel_worktree_root": "var/syncwheel",
  "version": 2
}
