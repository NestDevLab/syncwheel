{
  "authority": {
    "mode": "ai-managed",
    "allow": [
      "source_change",
      "runtime_change"
    ],
    "deny": [
      "destructive_rewrite"
    ]
  },
  "channels": [],
  "coordination": {
    "mode": "active-active",
    "id": "default",
    "remote": "origin",
    "state_branch": "syncwheel/state/default",
    "gc": {
      "worktree_grace_days": 7,
      "backup_retention_days": 30,
      "backup_keep": 2
    }
  },
  "defaults": {
    "base_branch": "main",
    "base_ref": "origin/main",
    "canonical_remote": "origin",
    "integration_membership": "required",
    "publication_remote": "origin"
  },
  "integration": {
    "base": "origin/main",
    "branch": "main-integration",
    "stacks": [
      "partial-intent-desired-refs",
      "preserve-published-ancestry"
    ],
    "strategy": "cherry-pick"
  },
  "landing": {
    "mode": "disabled",
    "strategy": "merge",
    "checks": null
  },
  "repository_mode": "delivery",
  "stacks": [
    {
      "id": "partial-intent-desired-refs",
      "branch": "pr/partial-intent-desired-refs",
      "base": "origin/main",
      "target_remote": "origin",
      "target_branch": "main",
      "integration_branch": "main-integration",
      "commits": [
        "04ec7ddfec77a3b710f64d7c1d1d1cca210c9fc6",
        "2e68fd634f7009b3a4056b19fb4468cd64b7c5f5"
      ],
      "state": "published",
      "publication": {
        "enabled": true
      },
      "meta": {
        "purpose": "Recover unlanded scoped publication when desired refs change"
      }
    },
    {
      "id": "preserve-published-ancestry",
      "branch": "pr/preserve-published-ancestry",
      "base": "origin/main",
      "target_remote": "origin",
      "target_branch": "main",
      "integration_branch": "main-integration",
      "commits": [
        "c2dd1ecc6c84b032245dc75ba684971ff1e00396"
      ],
      "state": "published",
      "publication": {
        "enabled": true
      },
      "meta": {
        "purpose": "Preserve validated local and published integration histories"
      }
    }
  ],
  "syncwheel_tracking": "git-tracked",
  "syncwheel_worktree_root": "var/syncwheel",
  "version": 2
}
