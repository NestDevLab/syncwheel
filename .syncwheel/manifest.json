{
  "authority": {
    "allow": [
      "source_change",
      "runtime_change"
    ],
    "deny": [
      "destructive_rewrite"
    ],
    "mode": "ai-managed"
  },
  "channels": [],
  "coordination": {
    "gc": {
      "backup_keep": 2,
      "backup_retention_days": 30,
      "worktree_grace_days": 7
    },
    "id": "default",
    "mode": "active-active",
    "remote": "origin",
    "state_branch": "syncwheel/state/default"
  },
  "defaults": {
    "base_branch": "main",
    "base_ref": "origin/main",
    "canonical_remote": "origin",
    "integration_membership": "required",
    "publication_remote": "origin"
  },
  "integration": {
    "base": "origin/main",
    "branch": "main-integration",
    "stacks": [
      "implicit-gc-scope"
    ],
    "strategy": "cherry-pick"
  },
  "landing": {
    "checks": null,
    "mode": "disabled",
    "strategy": "merge"
  },
  "repository_mode": "delivery",
  "stacks": [
    {
      "base": "origin/main",
      "branch": "pr/implicit-gc-scope",
      "commits": [
        "b941aad91cd9c0e6d748bfa7fdacda866ca2d7bd"
      ],
      "id": "implicit-gc-scope",
      "integration_branch": "main-integration",
      "meta": {
        "purpose": "Keep implicit gc away from other stacks' backups"
      },
      "publication": {
        "enabled": true
      },
      "state": "published",
      "target_branch": "main",
      "target_remote": "origin"
    }
  ],
  "syncwheel_tracking": "git-tracked",
  "syncwheel_worktree_root": "var/syncwheel",
  "version": 2
}
