{
  "authority": {
    "allow": [
      "source_change",
      "runtime_change"
    ],
    "deny": [
      "destructive_rewrite"
    ],
    "mode": "ai-managed"
  },
  "channels": [],
  "coordination": {
    "gc": {
      "backup_keep": 2,
      "backup_retention_days": 30,
      "worktree_grace_days": 7
    },
    "id": "default",
    "mode": "active-active",
    "remote": "origin",
    "state_branch": "syncwheel/state/default"
  },
  "defaults": {
    "base_branch": "main",
    "base_ref": "origin/main",
    "canonical_remote": "origin",
    "integration_membership": "required",
    "publication_remote": "origin"
  },
  "integration": {
    "base": "origin/main",
    "branch": "main-integration",
    "stacks": [
      "independent-worktree-open"
    ],
    "strategy": "cherry-pick"
  },
  "landing": {
    "checks": null,
    "mode": "disabled",
    "strategy": "merge"
  },
  "repository_mode": "delivery",
  "stacks": [
    {
      "base": "origin/main",
      "branch": "pr/independent-worktree-open",
      "commits": [
        "f6b3713eec9e4ade9a88d7a6e60069bbfc844326",
        "a23a8d8aa56e425e7f7285fb35cc5072b58df0fe",
        "71742a8cfef8b8d328132c45a48dd1a816f5b404"
      ],
      "id": "independent-worktree-open",
      "integration_branch": "main-integration",
      "meta": {
        "purpose": "Allow independent worktree open while unrelated expired lanes need explicit recovery"
      },
      "publication": {
        "enabled": true
      },
      "state": "published",
      "target_branch": "main",
      "target_remote": "origin"
    }
  ],
  "syncwheel_tracking": "git-tracked",
  "syncwheel_worktree_root": "var/syncwheel",
  "version": 2
}
