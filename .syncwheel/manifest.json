{
  "authority": {
    "allow": [
      "source_change",
      "runtime_change"
    ],
    "deny": [
      "destructive_rewrite"
    ],
    "mode": "ai-managed"
  },
  "channels": [],
  "coordination": {
    "gc": {
      "backup_keep": 2,
      "backup_retention_days": 30,
      "worktree_grace_days": 7
    },
    "id": "default",
    "mode": "active-active",
    "remote": "origin",
    "state_branch": "syncwheel/state/default"
  },
  "defaults": {
    "base_branch": "main",
    "base_ref": "origin/main",
    "canonical_remote": "origin",
    "integration_membership": "required",
    "publication_remote": "origin"
  },
  "integration": {
    "base": "origin/main",
    "branch": "main-integration",
    "stacks": [
      "github-empty-rules"
    ],
    "strategy": "cherry-pick"
  },
  "landing": {
    "checks": null,
    "mode": "disabled",
    "strategy": "merge"
  },
  "repository_mode": "delivery",
  "stacks": [
    {
      "base": "origin/main",
      "branch": "pr/github-empty-rules",
      "commits": [
        "5e4e0e9af4077083ebe3ca2cc0a01202a0a1d539",
        "1450780726ddc34425c97e84cc4c72e135ce3d33",
        "f840d0adfe62c954d117d127296e66d4a611a8af"
      ],
      "id": "github-empty-rules",
      "integration_branch": "main-integration",
      "meta": {
        "purpose": "Observe complete empty GitHub rule connections when private-plan REST endpoints are unavailable"
      },
      "publication": {
        "enabled": true
      },
      "state": "published",
      "target_branch": "main",
      "target_remote": "origin"
    }
  ],
  "syncwheel_tracking": "git-tracked",
  "syncwheel_worktree_root": "var/syncwheel",
  "version": 2
}
