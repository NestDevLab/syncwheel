{
  "authority": {
    "mode": "ai-managed",
    "allow": [
      "source_change",
      "runtime_change"
    ],
    "deny": [
      "destructive_rewrite"
    ]
  },
  "channels": [],
  "coordination": {
    "mode": "active-active",
    "id": "default",
    "remote": "origin",
    "state_branch": "syncwheel/state/default",
    "gc": {
      "worktree_grace_days": 7,
      "backup_retention_days": 30,
      "backup_keep": 2
    }
  },
  "defaults": {
    "base_branch": "main",
    "base_ref": "origin/main",
    "canonical_remote": "origin",
    "integration_membership": "required",
    "publication_remote": "origin"
  },
  "integration": {
    "base": "origin/main",
    "branch": "main-integration",
    "stacks": [
      "historical-closed-missing-tip",
      "historical-closed-missing-tip-v2"
    ],
    "strategy": "cherry-pick"
  },
  "landing": {
    "mode": "disabled",
    "strategy": "merge",
    "checks": null
  },
  "repository_mode": "delivery",
  "stacks": [
    {
      "id": "historical-closed-missing-tip",
      "branch": "syncwheel/draft/historical-closed-missing-tip",
      "base": "origin/main",
      "target_remote": "origin",
      "target_branch": "main",
      "integration_branch": "main-integration",
      "commits": [],
      "state": "draft",
      "publication": {
        "enabled": false
      },
      "meta": {
        "purpose": "Ignore pruned historical integration tips consistently during closed-stack recovery"
      }
    },
    {
      "id": "historical-closed-missing-tip-v2",
      "branch": "pr/historical-closed-missing-tip-v2",
      "base": "origin/main",
      "target_remote": "origin",
      "target_branch": "main",
      "integration_branch": "main-integration",
      "commits": [
        "e515208d404b7d504a5bb734053c91aa66557d49"
      ],
      "state": "published",
      "publication": {
        "enabled": true
      },
      "meta": {
        "purpose": "Preserve historical integration proofs for pruned states and managed reconciliation merges"
      }
    }
  ],
  "syncwheel_tracking": "git-tracked",
  "syncwheel_worktree_root": "var/syncwheel",
  "version": 2
}
