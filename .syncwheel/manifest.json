{
  "version": 2,
  "defaults": {
    "canonical_remote": "origin",
    "publication_remote": "origin",
    "base_branch": "main",
    "base_ref": "origin/main",
    "integration_membership": "required"
  },
  "integration": {
    "branch": "main-integration",
    "base": "origin/main",
    "strategy": "cherry-pick",
    "stacks": [
      "resume-tracked-manifest-atomic",
      "resume-manifest-replay-digest"
    ]
  },
  "stacks": [
    {
      "id": "resume-tracked-manifest-atomic",
      "branch": "pr/resume-tracked-manifest-atomic",
      "base": "origin/main",
      "target_remote": "origin",
      "target_branch": "main",
      "integration_branch": "main-integration",
      "commits": [
        "ab6ac399468c152f122b54850929bb6f93d08730"
      ],
      "state": "published",
      "publication": {
        "enabled": true
      },
      "meta": {
        "purpose": "Keep resume manifest persistence atomic across in-place replay"
      }
    },
    {
      "id": "resume-manifest-replay-digest",
      "branch": "pr/resume-manifest-replay-digest",
      "base": "origin/main",
      "target_remote": "origin",
      "target_branch": "main",
      "integration_branch": "main-integration",
      "commits": [
        "83759bdaf5764242cd44a44f1270435af6425581"
      ],
      "state": "published",
      "publication": {
        "enabled": true
      },
      "meta": {
        "purpose": "Accept the raw persisted manifest after an in-place replay"
      }
    }
  ],
  "syncwheel_worktree_root": "var/syncwheel",
  "syncwheel_tracking": "git-tracked",
  "coordination": {
    "mode": "active-active",
    "id": "default",
    "remote": "origin",
    "state_branch": "syncwheel/state/default",
    "gc": {
      "worktree_grace_days": 7,
      "backup_retention_days": 30,
      "backup_keep": 2
    }
  },
  "repository_mode": "delivery",
  "channels": []
}
