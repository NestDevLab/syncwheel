{
  "authority": {
    "allow": [
      "source_change",
      "runtime_change"
    ],
    "deny": [
      "destructive_rewrite"
    ],
    "mode": "ai-managed"
  },
  "channels": [],
  "coordination": {
    "gc": {
      "backup_keep": 2,
      "backup_retention_days": 30,
      "worktree_grace_days": 7
    },
    "id": "default",
    "mode": "active-active",
    "remote": "origin",
    "state_branch": "syncwheel/state/default"
  },
  "defaults": {
    "base_branch": "main",
    "base_ref": "origin/main",
    "canonical_remote": "origin",
    "integration_membership": "required",
    "publication_remote": "origin"
  },
  "integration": {
    "base": "origin/main",
    "branch": "main-integration",
    "stacks": [],
    "strategy": "cherry-pick"
  },
  "landing": {
    "checks": null,
    "mode": "disabled",
    "strategy": "merge"
  },
  "repository_mode": "delivery",
  "stacks": [],
  "syncwheel_tracking": "git-tracked",
  "syncwheel_worktree_root": "var/syncwheel",
  "version": 2
}
