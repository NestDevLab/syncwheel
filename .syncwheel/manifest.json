{
  "authority": {
    "mode": "ai-managed",
    "allow": [
      "source_change",
      "runtime_change"
    ],
    "deny": [
      "destructive_rewrite"
    ]
  },
  "channels": [],
  "coordination": {
    "mode": "active-active",
    "id": "default",
    "remote": "origin",
    "state_branch": "syncwheel/state/default",
    "gc": {
      "worktree_grace_days": 7,
      "backup_retention_days": 30,
      "backup_keep": 2
    }
  },
  "defaults": {
    "base_branch": "main",
    "base_ref": "origin/main",
    "canonical_remote": "origin",
    "integration_membership": "required",
    "publication_remote": "origin"
  },
  "integration": {
    "base": "origin/main",
    "branch": "main-integration",
    "stacks": [
      "pr-checks-none"
    ],
    "strategy": "cherry-pick"
  },
  "landing": {
    "mode": "disabled",
    "strategy": "merge",
    "checks": null
  },
  "repository_mode": "delivery",
  "stacks": [
    {
      "id": "pr-checks-none",
      "branch": "syncwheel/draft/pr-checks-none",
      "base": "origin/main",
      "target_remote": "origin",
      "target_branch": "main",
      "integration_branch": "main-integration",
      "commits": [],
      "state": "draft",
      "publication": {
        "enabled": false
      },
      "meta": {
        "purpose": "Allow explicit per-repository PR merge policies without CI"
      }
    }
  ],
  "syncwheel_tracking": "git-tracked",
  "syncwheel_worktree_root": "var/syncwheel",
  "version": 2
}
