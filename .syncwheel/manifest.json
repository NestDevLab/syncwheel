{
  "authority": {
    "mode": "ai-managed",
    "allow": [
      "source_change",
      "runtime_change"
    ],
    "deny": [
      "destructive_rewrite"
    ]
  },
  "channels": [],
  "coordination": {
    "mode": "active-active",
    "id": "default",
    "remote": "origin",
    "state_branch": "syncwheel/state/default",
    "gc": {
      "worktree_grace_days": 7,
      "backup_retention_days": 30,
      "backup_keep": 2
    }
  },
  "defaults": {
    "base_branch": "main",
    "base_ref": "origin/main",
    "canonical_remote": "origin",
    "integration_membership": "required",
    "publication_remote": "origin"
  },
  "integration": {
    "base": "origin/main",
    "branch": "main-integration",
    "stacks": [
      "read-only-git-auth",
      "recover-semantic-lease"
    ],
    "strategy": "cherry-pick"
  },
  "landing": {
    "mode": "disabled",
    "strategy": "merge",
    "checks": null
  },
  "repository_mode": "delivery",
  "stacks": [
    {
      "base": "origin/main",
      "branch": "pr/read-only-git-auth",
      "commits": [
        "dffccd1eab3b9e248dbdcb3057011f21ef3941ac"
      ],
      "id": "read-only-git-auth",
      "integration_branch": "main-integration",
      "meta": {
        "purpose": "Skip ref-move authorization for read-only Git children"
      },
      "publication": {
        "enabled": true
      },
      "state": "published",
      "target_branch": "main",
      "target_remote": "origin"
    },
    {
      "id": "recover-semantic-lease",
      "branch": "syncwheel/draft/recover-semantic-lease",
      "base": "origin/main",
      "target_remote": "origin",
      "target_branch": "main",
      "integration_branch": "main-integration",
      "commits": [],
      "state": "draft",
      "publication": {
        "enabled": false
      },
      "meta": {
        "purpose": "Keep recover tolerant of benign concurrent git readers (MGT-0333 items 1-2)"
      }
    }
  ],
  "syncwheel_tracking": "git-tracked",
  "syncwheel_worktree_root": "var/syncwheel",
  "version": 2
}
