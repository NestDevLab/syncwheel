{
  "authority": {
    "mode": "ai-managed",
    "allow": [
      "source_change",
      "runtime_change"
    ],
    "deny": [
      "destructive_rewrite"
    ]
  },
  "channels": [],
  "coordination": {
    "mode": "active-active",
    "id": "default",
    "remote": "origin",
    "state_branch": "syncwheel/state/default",
    "gc": {
      "worktree_grace_days": 7,
      "backup_retention_days": 30,
      "backup_keep": 2
    }
  },
  "defaults": {
    "base_branch": "main",
    "base_ref": "origin/main",
    "canonical_remote": "origin",
    "integration_membership": "required",
    "publication_remote": "origin"
  },
  "integration": {
    "base": "origin/main",
    "branch": "main-integration",
    "stacks": [
      "historical-coordination-digest"
    ],
    "strategy": "cherry-pick"
  },
  "landing": {
    "mode": "disabled",
    "strategy": "merge",
    "checks": null
  },
  "repository_mode": "delivery",
  "stacks": [
    {
      "base": "origin/main",
      "branch": "pr/historical-coordination-digest-governed",
      "commits": [
        "d878a6b68898a67c618db2406f9ae7fba3f7dcb0",
        "8128d73c0d9b0e590b7c874266dff2cb068d384d"
      ],
      "id": "historical-coordination-digest",
      "integration_branch": "main-integration",
      "meta": {},
      "publication": {
        "enabled": true
      },
      "state": "published",
      "target_branch": "main",
      "target_remote": "origin"
    }
  ],
  "syncwheel_tracking": "git-tracked",
  "syncwheel_worktree_root": "var/syncwheel",
  "version": 2
}
