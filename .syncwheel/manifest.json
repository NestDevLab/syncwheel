{
  "authority": {
    "mode": "ai-managed",
    "allow": [
      "source_change",
      "runtime_change"
    ],
    "deny": [
      "destructive_rewrite"
    ]
  },
  "channels": [],
  "coordination": {
    "mode": "active-active",
    "id": "default",
    "remote": "origin",
    "state_branch": "syncwheel/state/default",
    "gc": {
      "worktree_grace_days": 7,
      "backup_retention_days": 30,
      "backup_keep": 2
    }
  },
  "defaults": {
    "base_branch": "main",
    "base_ref": "origin/main",
    "canonical_remote": "origin",
    "integration_membership": "required",
    "publication_remote": "origin"
  },
  "integration": {
    "base": "origin/main",
    "branch": "main-integration",
    "stacks": [
      "github-empty-rules",
      "journal-recover",
      "journal-recover-delivery"
    ],
    "strategy": "cherry-pick"
  },
  "landing": {
    "mode": "disabled",
    "strategy": "merge",
    "checks": null
  },
  "repository_mode": "delivery",
  "stacks": [
    {
      "id": "github-empty-rules",
      "branch": "pr/github-empty-rules",
      "base": "origin/main",
      "target_remote": "origin",
      "target_branch": "main",
      "integration_branch": "main-integration",
      "commits": [
        "65ba0f93c3533afa54cc50df47ce1641c950f6df"
      ],
      "state": "published",
      "publication": {
        "enabled": true
      },
      "meta": {
        "purpose": "Observe complete empty GitHub rule connections when private-plan REST endpoints are unavailable"
      }
    },
    {
      "id": "journal-recover",
      "branch": "pr/journal-recover",
      "base": "origin/main",
      "target_remote": "origin",
      "target_branch": "main",
      "integration_branch": "main-integration",
      "commits": [],
      "state": "published",
      "publication": {
        "enabled": true
      },
      "meta": {
        "purpose": "Recover unpublished diverged journal snapshots safely"
      }
    },
    {
      "id": "journal-recover-delivery",
      "branch": "pr/journal-recover-delivery",
      "base": "origin/main",
      "target_remote": "origin",
      "target_branch": "main",
      "integration_branch": "main-integration",
      "commits": [
        "a2661bf927fba1b0384e6dab10888da57686f925",
        "f70d1293e6b2262ff27daf36e690b35ca1b40818"
      ],
      "state": "published",
      "publication": {
        "enabled": true
      },
      "meta": {
        "purpose": "Guarded recovery of unpublished diverged journal snapshots"
      }
    }
  ],
  "syncwheel_tracking": "git-tracked",
  "syncwheel_worktree_root": "var/syncwheel",
  "version": 2
}
